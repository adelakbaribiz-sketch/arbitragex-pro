# No environment variables are required to run this demo — the app runs
# entirely on a deterministic simulated data layer (see docs/DEMO.md and
# docs/LIMITATIONS.md). The variables below are placeholders for the real
# backend integration described in docs/ROADMAP.md; none of them are read
# by any code in this repository today.

# NEXT_PUBLIC_API_BASE_URL=       # real backend base URL, once one exists
# DATABASE_URL=                   # Postgres connection string (Phase 1)
# AUTH_SECRET=                    # session/JWT signing secret (Phase 1)
